RewriteEngine On 
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?dumindia\.in$ [NC]
RewriteRule ^presentations2026\.php$ https://dumindia.in/presentations2026.php [R=301,L]

RewriteCond %{SERVER_PORT} 80
RewriteCond %{HTTP_HOST} ^(www\.)?indiacgd\.in
RewriteRule ^(.*)$ https://www.indiacgd.in/$1 [R,L]